	<parameter name="P_PROJ_ID" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["P001"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT task_id, proj_id, task_name, priority, status, progress
FROM tasks
WHERE proj_id = $P{P_PROJ_ID}]]>
	</queryString>
	<field name="task_id" class="java.lang.String"/>
	<field name="proj_id" class="java.lang.String"/>
	<field name="task_name" class="java.lang.String"/>
	<field name="priority" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
	<field name="progress" class="java.lang.Integer"/>
	<variable name="V_TASK_COUNT" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{task_id}]]></variableExpression>
	</variable>
	<variable name="V_COMPLETE_COUNT" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{status}.equals("Complete") ? $F{task_id} : null]]></variableExpression>
	</variable>
	<variable name="V_BLOCKED_COUNT" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{status}.equals("Blocked") ? $F{task_id} : null]]></variableExpression>
	</variable>
	<variable name="V_AVG_PROGRESS" class="java.lang.Double" calculation="Average">
		<variableExpression><![CDATA[Double.valueOf($F{progress}.toString())]]></variableExpression>
	</variable>
